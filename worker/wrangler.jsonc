{
  "name": "vpn-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [], // свой домен: pattern "sub.<ваш-домен>", custom_domain true
  "kv_namespaces": [{ "binding": "SUBS", "id": "b7d8b3d7b5c449629e1527d73f144459" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vpn-registry",
      "database_id": "3fa58c54-4410-471a-a158-bb01e9583e99",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ACCESS_ISS": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAIL": ""
  },
  "observability": { "enabled": false }
}
